# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# `npm run dev`, `npm start` and `npm run seed` read it. The tests never do.
# On Render you enter these three in the dashboard instead (render.yaml declares them).

# Supabase Postgres connection string. In the Supabase dashboard: Connect, then
# "Transaction pooler". It must be the POOLER address (transaction mode, IPv4),
# not the direct connection, which is IPv6-only on the free plan.
# URL-encode the database password (for example "@" becomes %40, "/" becomes %2F).
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Supabase project URL. Dashboard: Project Settings, then API, "Project URL".
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (starts with sb_publishable_). Dashboard: Project Settings,
# then API Keys. It is meant to be public. Never use the secret or service_role key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
